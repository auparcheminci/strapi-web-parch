{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Produits",
    "description": "Create your blog content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "designation": {
      "type": "string",
      "required": true
    },
    "reference-parch": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "reference-fournisseur": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "codebarre": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "slug": {
      "type": "uid"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "technical-file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "support-de-communication": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "ranges": {
      "type": "component",
      "component": "shared.product-attribute",
      "repeatable": true
    },
    "packaging": {
      "type": "enumeration",
      "enum": [
        "Blister",
        "Display"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "required": true,
      "inversedBy": "articles"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.media"
      ]
    }
  }
}
